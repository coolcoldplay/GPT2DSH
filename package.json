{
  "name": "dsh-chat-import",
  "description": "GPT2DSH: browse and search ChatGPT exports locally, restore research reports, and continue conversations in DeepSeek Harness. | 本地浏览与搜索 ChatGPT 备份，恢复研究报告，在 DeepSeek Harness 中切换模型继续聊。",
  "version": "0.26.4-chatgpt.5",
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "icon": "assets/import.svg",
  "bin": {
    "dsh-chat-import": "bin/dsh-chat-import.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./export.mjs": "./lib/export/index.mjs",
    "./CHANGELOG.md": "./CHANGELOG.md",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.mjs",
    "lib/*.js",
    "lib/index.d.ts",
    "lib/convert",
    "lib/discovery",
    "lib/export",
    "lib/sources",
    "lib/tools",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "docs/*.md",
    "docs/*.png",
    "CHANGELOG.md",
    "assets/import.svg",
    "assets/dci-promo.png",
    "assets/agents",
    "LICENSE",
    "UPSTREAM.md",
    "THIRD_PARTY_NOTICES.md",
    "NOTICE",
    "third_party/licenses"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.0.0",
    "react": ">=18.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "claude-code",
    "codex",
    "chatgpt",
    "cursor",
    "gemini",
    "antigravity",
    "reasonix",
    "pi-coding-agent",
    "opencode",
    "zcode",
    "grokbuild",
    "openclaw",
    "hermes",
    "kimi",
    "kimi-cli",
    "qoder",
    "qoder-cli",
    "workbuddy",
    "trae",
    "trae-work",
    "sqlite",
    "import",
    "jsonl",
    "migration",
    "transcript"
  ],
  "author": "Nwflower <1679659@qq.com>",
  "homepage": "https://github.com/coolcoldplay/GPT2DSH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coolcoldplay/GPT2DSH.git"
  },
  "bugs": {
    "url": "https://github.com/coolcoldplay/GPT2DSH/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "coverage": "node --test --test-reporter=spec --experimental-test-coverage --test-coverage-lines=75 \"test/*.test.mjs\"",
    "check:coverage": "npm run coverage | node .github/scripts/check-coverage.mjs",
    "lint": "eslint .",
    "check:linux": "node .github/scripts/check-linux-compat.mjs",
    "check:leaks": "node .github/scripts/check-leaks.mjs",
    "check:links": "node .github/scripts/check-doc-links.mjs",
    "check:tests": "node .github/scripts/check-test-discipline.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build": "node scripts/build-client.mjs --check && node .github/scripts/build-check.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && git diff --quiet && git diff --cached --quiet && npm pack --dry-run"
  },
  "license": "MIT",
  "devDependencies": {
    "eslint": "^10.8.1"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "fflate": "0.8.3",
    "fzstd": "^0.1.1",
    "pdfjs-dist": "6.5.438"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "private": true,
  "gpt2dsh": {
    "upstream": {
      "repository": "https://github.com/Nwflower/dsh-chat-import",
      "commit": "c1c4f627d03d95a60dd8bade12212150ed8af276"
    },
    "compatibilityPackage": "dsh-chat-import"
  }
}
